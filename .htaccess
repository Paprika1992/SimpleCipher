RewriteEngine On
RewriteBase /

# Публичный API: соль обязательна для шифрования и дешифрования
RewriteRule ^api/(.*)$ CipherController.php?endpoint=$1 [L]

# Демонстрационная страница: разрешен режим без пользовательской соли
RewriteRule ^demo/(getEncryptText|getDecryptText)$ CipherDemoController.php?endpoint=$1 [L]
